[Unit]
Description=AI Service Triage PoC
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=farhad
WorkingDirectory=/home/farhad/ai-service-triage-poc
EnvironmentFile=/etc/ai-triage.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/farhad/ai-service-triage-poc/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
